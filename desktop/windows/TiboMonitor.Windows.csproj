<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TiboMonitor</AssemblyName>
    <RootNamespace>TiboMonitor.Windows</RootNamespace>
    <Version>0.1.1</Version>
    <Product>Token重置</Product>
    <ApplicationIcon Condition="Exists('..\assets\AppIcon.ico')">..\assets\AppIcon.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
  </ItemGroup>
</Project>
